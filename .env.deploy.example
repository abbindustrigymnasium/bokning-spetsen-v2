# Public URLs used by the browser and Microsoft Entra app registration
FRONTEND_URL=https://booking.example.com
VITE_API_URL=https://api.booking.example.com
ENTRA_REDIRECT_URI=https://booking.example.com/auth

# Microsoft Entra app registration
ENTRA_CLIENT_ID=
ENTRA_DIRECTORY_ID=
ENTRA_VALUE=

# Generate strong, independent secrets for these values
SESSION_SECRET=
POSTGRES_PASSWORD=

# Keep this password in sync with POSTGRES_PASSWORD. URL-encode special characters.
DATABASE_URL=postgresql://bokning_spetsen:change-me@postgres:5432/bokning_spetsen?schema=public

# Optional deployment overrides
# POSTGRES_DB=bokning_spetsen
# POSTGRES_USER=bokning_spetsen
# BIND_ADDRESS=0.0.0.0
# FRONTEND_PORT=3000
# BACKEND_PORT=3001
# APP_IMAGE=bokning-spetsen:latest
# MIGRATOR_IMAGE=bokning-spetsen-migrator:latest
