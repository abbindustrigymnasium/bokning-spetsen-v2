# Microsoft Entra ID app registration
ENTRA_CLIENT_ID=
ENTRA_DIRECTORY_ID=
ENTRA_SECRET_ID= # informational only; do not use this as the client secret
ENTRA_VALUE= # client secret value; copy it when the secret is created
ENTRA_REDIRECT_URI=http://localhost:5173/auth

# Use a long random value in every environment
SESSION_SECRET=
FRONTEND_URL=http://localhost:5173

# Development only: authenticated API requests use this seeded user
DEV_USER_EMAIL=example@mail.com

# Optional when the frontend and API are not on localhost
VITE_API_URL=http://localhost:3001
